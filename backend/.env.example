# Copy this file to .env and fill in real values:
#
#     cp .env.example .env
#
# .env is gitignored -- never commit real credentials.

# MongoDB connection string (local instance or Atlas).
MONGO_URI=

# Secret used to sign JWTs. Generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Port the API listens on. Defaults to 5000 if unset.
PORT=5000

# Google Gemini API key -- create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Origin allowed by CORS. Set this to your deployed frontend URL in production.
# Leave blank for local development: localhost:5173 and localhost:80 are always allowed.
CLIENT_URL=

# Runtime mode. Set to "production" in deployed environments: this enforces the
# CORS allowlist above and switches logs from human-readable to single-line JSON.
NODE_ENV=development

# Log verbosity: trace, debug, info, warn, error or fatal. Defaults to info.
LOG_LEVEL=info
